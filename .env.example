# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# HMRC Developer Hub (sandbox)
HMRC_CLIENT_ID=your_hmrc_client_id
HMRC_CLIENT_SECRET=your_hmrc_client_secret
HMRC_API_BASE_URL=https://test-api.service.hmrc.gov.uk
HMRC_OAUTH_REDIRECT_URI=http://localhost:3000/api/auth/hmrc/callback
# Public IP of the server that calls HMRC (Gov-Vendor-Public-IP)
HMRC_VENDOR_PUBLIC_IP=203.0.113.6
HMRC_PRODUCT_NAME=TaxBridge UK
# Secret used to hash the licence ID header (Gov-Vendor-License-IDs)
HMRC_LICENSE_SECRET=change-me

# AI categorisation (optional; rows fall back to "other" without it)
OPENAI_API_KEY=sk-...

# 64 hex characters (32 bytes) for AES-256-GCM. Generate: openssl rand -hex 32
ENCRYPTION_KEY=
